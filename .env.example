GOOGLE_API_KEY=your-key-here

# Keys clients must send as "Authorization: Bearer <key>" to call /chat.
# Comma-separated (list two while rotating); each must be at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, /chat rejects every request.
GATEWAY_API_KEYS=

# Per-client limit on /chat, counted per API key, not globally.
# Defaults: 5 requests per 60 seconds. This sits well under Gemini's free-tier
# RPM so a client gets a clean 429 from us before hitting a confusing upstream
# error. Set RATE_LIMIT_REQUESTS=0 to close /chat to every client.
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Input guardrails that run on /chat, comma-separated.
# Known checks: email, card, phone, injection. Unset means all of them are on;
# set-but-empty turns them all off. Drop `phone` first if you hit false
# positives - it is the loosest of the three PII checks.
GUARDRAIL_CHECKS=email,card,phone,injection

# Complexity routing. Messages estimating below ROUTING_TOKEN_THRESHOLD tokens
# (roughly characters / 4) go to GEMINI_CHEAP_MODEL; at or above it they use
# GEMINI_MODEL. A failed call is retried once on the other tier.
# Set GEMINI_CHEAP_MODEL equal to GEMINI_MODEL to turn the fallback off.
GEMINI_CHEAP_MODEL=gemini-flash-lite-latest
ROUTING_TOKEN_THRESHOLD=1000
